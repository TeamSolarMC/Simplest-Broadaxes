{
	"schemaVersion": 1,
	"id": "${mod_id}",
	"version": "${mod_version}",
	"name": "${mod_name}",
	"description": "${mod_description}",
	"authors": [
		"${mod_authors}"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "${mod_license}",
	"icon": "assets/simplest_broadaxes/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			{
				"value": "net.teamsolar.simplest_broadaxes.SimplestBroadaxes",
				"adapter": "kotlin"
			}
		],
		"fabric-datagen": [
			{
				"value": "net.teamsolar.simplest_broadaxes.datagen.ModDataGenerator",
				"adapter": "kotlin"
			}
		]
	},
	"depends": {
		"fabricloader": ">=0.16.10",
		"minecraft": "~${minecraft_version}",
		"java": ">=17",
		"fabric-api": "*",
		"fabric-language-kotlin": "*"
	}
}